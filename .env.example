# Twilio Configuration
# Copy this file to .env and replace the placeholder values with your actual Twilio credentials

# Your Twilio Account SID (found in your Twilio Console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Auth Token (found in your Twilio Console)
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio Flex Workspace SID
TWILIO_WORKSPACE_SID=WSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Flex Workflow SID
TWILIO_WORKFLOW_SID=WWxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Flex Queue SID
TWILIO_QUEUE_SID=WQxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Your Twilio Proxy Service SID
TWILIO_PROXY_SERVICE_SID=KSxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
